    <string name="tut_goal_title">The Goal</string>
    <string name="tut_goal_text">Decode a famous quote that has been encrypted by substituting each letter of the alphabet with a different letter.</string>
    <string name="tut_select_title">Selecting &amp; Typing</string>
    <string name="tut_select_text">Tap any letter tile to select it — all tiles sharing the same cipher letter highlight together. Then tap a letter on the keyboard to assign your guess.</string>
    <string name="tut_cipher_title">The Cipher</string>
    <string name="tut_cipher_text">Every A in the original might be encoded as, say, K. Your job is to figure out each substitution. Each cipher letter maps to exactly one plain letter.</string>
    <string name="tut_mistakes_title">Correcting Mistakes</string>
    <string name="tut_mistakes_text">Tap a tile that already has a letter to select its cipher group, then type a new letter to replace it, or tap Erase to clear all tiles of that cipher letter.</string>
    <string name="tut_hints_title">Hints</string>
    <string name="tut_hints_text">Stuck? Tap Hint to reveal the correct plain letter for the currently selected cipher letter. The attribution (author) is always shown to give you a nudge.</string>
